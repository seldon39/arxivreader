<!-- Fenêtre de l'application Windows (comme macos/main.swift sur le Mac) : WebView2, le moteur d'Edge présent sur
     Windows 10 et 11, dans une fenêtre à onglets. .NET Framework 4.8, inclus dans Windows : rien à installer. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>arXivReader</AssemblyName>
    <RootNamespace>ArxivReader</RootNamespace>
    <ApplicationIcon>..\arXivReader.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
